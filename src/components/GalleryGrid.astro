---
// Photo-gallery thumbnail grid. Each thumbnail is a `.lightbox-trigger` for the
// shared <Lightbox />, carrying the large source, caption, and filename (for
// shareable deep links).
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { imageName } from '../lib/imageName';

interface Props {
	gallery: CollectionEntry<'galleries'>;
}

const { gallery } = Astro.props;

// Thumbnails are cover-cropped to the tile's 3:2 ratio so wide panoramas keep
// full resolution (a plain width-only resize would squash them to a few pixels
// tall and then upscale). The full-size source feeds the lightbox.
const items = await Promise.all(
	gallery.data.images.map(async (image) => {
		const full = await getImage({ src: image.img, width: 1600, quality: 80 });
		const thumb = await getImage({
			src: image.img,
			width: 600,
			height: 400,
			fit: 'cover',
			position: 'center',
			quality: 60,
		});
		return { thumb: thumb.src, caption: image.caption, full: full.src, name: imageName(image.img.src) };
	}),
);
---

<section class="gallery-grid">
	{items.map((item) => (
		<button
			type="button"
			class="lightbox-trigger gallery-thumb"
			data-full={item.full}
			data-caption={item.caption}
			data-name={item.name}
			aria-label={`View image: ${item.caption}`}
		>
			<img src={item.thumb} alt={item.caption} width="600" height="400" loading="eager" decoding="async" />
		</button>
	))}
</section>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
		gap: clamp(1rem, 2vw, 1.5rem);
	}
	.gallery-thumb {
		aspect-ratio: 3 / 2;
		padding: 0;
		border: 1px solid var(--glass-border);
		border-radius: 1.5rem;
		background: none;
		overflow: clip;
		outline: none;
		cursor: zoom-in;
		box-shadow: var(--shadow-sm);
		transition:
			box-shadow var(--theme-transition),
			transform var(--theme-transition);
	}

	.gallery-thumb:hover,
	.gallery-thumb:focus-visible {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}
	.gallery-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
