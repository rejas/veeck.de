---
import 'plyr/dist/plyr.css';

interface Props {
	file: string;
	caption: string;
}

const { file, caption } = Astro.props;
---

<div class="audio-card">
	<p class="caption">{caption}</p>
	<audio data-plyr controls>
		<source src={file} type="audio/mpeg" />
		Your browser does not support the audio element.
	</audio>
</div>

<script>
	import Plyr from 'plyr';

	document.querySelectorAll<HTMLAudioElement>('audio[data-plyr]:not([data-plyr-ready])').forEach((audio) => {
		audio.dataset.plyrReady = 'true';
		new Plyr(audio);
	});
</script>

<style>
	.audio-card {
		width: 100%;
		padding: 1.25rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
	}

	.caption {
		margin: 0 0 0.75rem;
		font-family: var(--font-brand);
		font-weight: 600;
		color: var(--gray-0);
	}

	.audio-card :global(.plyr) {
		--plyr-color-main: var(--accent-regular);
		--plyr-audio-controls-background: transparent;
		--plyr-audio-control-color: var(--gray-100);
		--plyr-audio-control-color-hover: var(--gray-999);
		--plyr-audio-control-background-hover: var(--accent-regular);
		--plyr-font-family: var(--font-body);
		--plyr-font-size-time: var(--text-sm);
	}
</style>
