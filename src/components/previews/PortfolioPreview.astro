---
import type { CollectionEntry } from 'astro:content';
import CardPreview from './CardPreview.astro';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { data, id } = Astro.props.project;
---

<CardPreview href={`/projects/${id}`} title={data.title} image={data.img} imageAlt={data.img_alt} />
