---
import type { CollectionEntry } from 'astro:content';
import CardPreview from './CardPreview.astro';

interface Props {
	gallery: CollectionEntry<'galleries'>;
}

const { data, id } = Astro.props.gallery;
---

<CardPreview href={`/photos/${id}`} title={data.title} image={data.img} imageAlt={data.img_alt} />
