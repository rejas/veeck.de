---
import type { CollectionEntry } from 'astro:content';
import CardPreview from './CardPreview.astro';

interface Props {
	travel: CollectionEntry<'travels'>;
}

const { data, id } = Astro.props.travel;
---

<CardPreview href={`/travels/${id}`} title={data.tags.join(', ')} image={data.img} imageAlt={data.img_alt} />
